# SkillNova Production Environment Configuration
# Copy this file to .env.local for local development or set in your production hosting platform (e.g. Vercel, Railway, AWS ECS).

# -----------------------------------------------------------------------------
# 1. Application Base URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://skillnova.yourdomain.com

# -----------------------------------------------------------------------------
# 2. PostgreSQL Database Connection (Prisma)
# Required for persistent records across instances and container restarts.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/skillnova?schema=public

# -----------------------------------------------------------------------------
# 3. Authentication & Session Secrets
# Used to sign and verify HttpOnly JWT session cookies (HS256).
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=replace_with_a_secure_random_base64_secret_key_in_production

# -----------------------------------------------------------------------------
# 4. LiveKit WebRTC Infrastructure
# Obtain credentials from LiveKit Cloud (https://cloud.livekit.io) or your self-hosted LiveKit Server.
# The server URL must be the WebSocket endpoint (wss://).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# -----------------------------------------------------------------------------
# 5. Database Setup Commands:
# npx prisma generate
# npx prisma db push  (or npx prisma migrate deploy)
# -----------------------------------------------------------------------------
